              "raw": "{\n  \"InstanceArn\": \"arn:aws-cn:sso:::instance/ssoins-bogCe2kG8gU69df4\",\n  \"TargetId\": \"747412940080\",\n  \"TargetType\": \"AWS_ACCOUNT\",\n  \"PermissionSetArn\": \"arn:aws-iso-b:sso:::permissionSet/ssoins-F8vpNwDGjGCOgorN/ps-eOgw/WHNPIvCY7xv\",\n  \"PrincipalType\": \"GROUP\",\n  \"PrincipalId\": \"b19D8596-143c-ED94-Dd83-829cFA3Cb17b\"\n}",
